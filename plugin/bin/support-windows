#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from runtools.runcheck import _findings
from runtools.support import build_windows

if len(sys.argv) != 2:
    print("usage: support-windows <run_dir>", file=sys.stderr)
    sys.exit(2)
run_dir = sys.argv[1]
doc = build_windows(run_dir, _findings(run_dir))
counts = {}
for p in doc["pairs"]:
    counts[p["window_status"]] = counts.get(p["window_status"], 0) + 1
print(json.dumps({"pairs": len(doc["pairs"]), "window_status": counts, "file": os.path.join(run_dir, "support-windows.json")}))
