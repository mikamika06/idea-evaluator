#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from runtools.pagetext import fetch

args = [a for a in sys.argv[1:] if a != "--fresh"]
if len(args) != 1:
    print("usage: fetch-text [--fresh] <url>", file=sys.stderr)
    sys.exit(2)
meta = fetch(args[0], fresh="--fresh" in sys.argv[1:])
print(json.dumps(meta))
sys.exit(0 if meta.get("ok") else 1)
