#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from runtools.recheck import recheck

if len(sys.argv) != 3:
    print("usage: recheck <run_dir> <claims.json>", file=sys.stderr)
    sys.exit(2)
with open(sys.argv[2]) as f:
    claims = json.load(f)
audit = recheck(sys.argv[1], claims)
checks = {}
for c in audit["checked"]:
    checks[c["quote_check"]] = checks.get(c["quote_check"], 0) + 1
print(json.dumps({"status": audit["status"], "quote_checks": checks, "claims": [(c["code"], c["verdict"]) for c in audit["decisive_claims"]], "missing_languages": audit["missing_languages"], "windows": os.path.join(sys.argv[1], "support-windows.json")}))
