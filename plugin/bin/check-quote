#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from runtools.pagetext import check_quote

if len(sys.argv) != 3:
    print("usage: check-quote <url> <quote>", file=sys.stderr)
    sys.exit(2)
print(json.dumps(check_quote(sys.argv[1], sys.argv[2])))
